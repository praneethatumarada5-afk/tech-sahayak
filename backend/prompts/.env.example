# Copy this file to ".env" and fill in your key. NEVER commit .env.

# Get a free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# Free-tier friendly model. Check AI Studio for the current model names and free limits;
# if this one is retired, put the new name here (no code change needed).
GEMINI_MODEL=gemini-3.5-flash

# Lower = more careful and consistent (good for a tutor). 0.2 to 0.5 is a sensible range.
GEMINI_TEMPERATURE=0.4

# Set to 1 to test everything WITHOUT calling Gemini (prints a fake reply). Useful offline.
MOCK_LLM=0

# Port for the optional demo HTTP server (server.js)
PORT=3001
